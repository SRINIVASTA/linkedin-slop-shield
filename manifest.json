{
  "manifest_version": 3,
  "name": "LinkedIn Slop Shield",
  "version": "1.0",
  "description": "Blurs out semantic AI slop using TypeSafe Jev.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://*://*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
